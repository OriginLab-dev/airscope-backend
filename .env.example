PORT=3000
DB_HOST=
DB_PORT=4000
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_SSL=true
# If Windows DNS cannot resolve the TiDB hostname, the backend securely
# falls back to Cloudflare DNS for that hostname only.
OPENAQ_API_KEY=
OPENAQ_REFRESH_INTERVAL_MS=3600000
## Comma-separated Vercel front-end origins, for example:
## CORS_ORIGIN=https://your-project.vercel.app,http://localhost:3001
CORS_ORIGIN=
